# WHY this file exists: it documents EVERY config value the service needs.
# Copy to `.env` for local non-Docker runs. Each value is validated at boot
# (src/config/env.ts) so a typo crashes immediately with a clear message
# instead of failing mysteriously under load later.

NODE_ENV=development
PORT=3000

# Postgres. Host "localhost" for running the backend on your machine;
# docker-compose overrides the host to the "db" service name.
DATABASE_URL=postgresql://app:app@localhost:5432/usermngmt?schema=public

# Auth secrets — in real deployments generate strong values:  openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
ACCESS_TOKEN_TTL=900       # seconds (15 minutes) — short-lived on purpose
REFRESH_TOKEN_TTL=604800   # seconds (7 days)

# Where the React app runs (for CORS allow-list)
CORS_ORIGIN=http://localhost:5173

# Send the refresh cookie only over HTTPS. false for local HTTP; true in prod.
COOKIE_SECURE=false
