NODE_ENV=development
PORT=3000

# Postgres. Host localhost:5433 when using docker-compose db service.
DATABASE_URL=postgresql://app:app@localhost:5433/usermngmt?schema=public

# Better Auth
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000

# Where the React app runs (CORS + trustedOrigins)
CORS_ORIGIN=http://localhost:5173
